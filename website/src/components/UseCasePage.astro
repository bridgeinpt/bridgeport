---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

/**
 * Shared layout for /use-cases/* pages — solution-oriented landing pages that
 * target a specific job ("deploy Docker to multiple servers", "self-hosted
 * monitoring"). Each page supplies data; this renders layout + structured data
 * (BreadcrumbList + FAQPage). Claims must map to documented behavior — every
 * feature block links to the guide that backs it.
 */

interface Step {
  title: string;
  text: string;
}

interface Feature {
  title: string;
  text: string;
  href: string;
  linkText: string;
}

interface Props {
  /** Visible h1 / page title — the search phrase, e.g. "Deploy Docker to Multiple Servers". */
  title: string;
  description: string;
  /** Mono eyebrow line. */
  framing: string;
  intro: string[];
  /** "How it works" numbered steps. */
  steps: Step[];
  /** "What you get" feature blocks, each backed by a docs link. */
  features: Feature[];
  faqs: { q: string; a: string }[];
  /** Related reading links shown before the CTA. */
  related: { href: string; text: string }[];
}

const { title, description, framing, intro, steps, features, faqs, related } = Astro.props;

const SITE = 'https://bridgeport.bridgein.com';
const pagePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'BridgePort', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Use cases', item: `${SITE}/use-cases/` },
        { '@type': 'ListItem', position: 3, name: title, item: `${SITE}${pagePath}` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});
---

<StarlightPage
  frontmatter={{
    title,
    description,
    template: 'splash',
    tableOfContents: false,
    editUrl: false,
    head: [{ tag: 'script', attrs: { type: 'application/ld+json' }, content: jsonLd }],
  }}
>
  <div class="uc">
    <nav class="uc-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href="/use-cases/">Use cases</a>
    </nav>
    <p class="uc-framing">{framing}</p>

    {intro.map((p) => <p class="uc-intro">{p}</p>)}

    <h2 id="how-it-works">How it works</h2>
    <ol class="uc-steps">
      {
        steps.map((step, i) => (
          <li class="uc-step">
            <span class="uc-step-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </li>
        ))
      }
    </ol>

    <h2 id="what-you-get">What you get</h2>
    <div class="uc-features">
      {
        features.map((f) => (
          <div class="uc-feature">
            <h3>{f.title}</h3>
            <p>{f.text}</p>
            <a href={f.href}>{f.linkText} →</a>
          </div>
        ))
      }
    </div>

    <slot />

    <h2 id="faq">Frequently asked questions</h2>
    <div class="uc-faqs">
      {
        faqs.map((f) => (
          <details class="uc-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>

    <p class="uc-related">
      Related reading:{' '}
      {related.map((r, i) => (
        <>
          {i > 0 && ' · '}
          <a href={r.href}>{r.text}</a>
        </>
      ))}
    </p>

    <aside class="uc-cta">
      <p class="uc-cta-title">Try it on your own servers</p>
      <p>
        BridgePort installs as a single container in about a minute — self-hosted, Apache-2.0, no
        strings.
      </p>
      <div class="uc-cta-actions">
        <a class="uc-btn uc-btn-primary" href="/getting-started/">Get started</a>
        <a class="uc-btn" href="/use-cases/">All use cases</a>
        <a class="uc-btn" href="/faq/">FAQ</a>
      </div>
    </aside>
  </div>
</StarlightPage>

<style is:global>
  .uc {
    --uc-border: color-mix(in srgb, var(--sl-color-gray-5) 72%, transparent);
    --uc-mono: 'IBM Plex Mono', ui-monospace, monospace;
    --uc-display: 'IBM Plex Sans', var(--sl-font);
    max-width: 52rem;
    margin-inline: auto;
  }

  .uc-crumbs {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--uc-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.75rem;
  }
  .uc-crumbs a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .uc-crumbs a:hover {
    color: var(--sl-color-accent-high);
  }

  .uc-framing {
    font-family: var(--uc-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
    margin: 0 0 1.5rem;
  }
  .uc-framing::before {
    content: '//';
    color: #cc0000;
    margin-right: 0.6em;
  }

  .uc .uc-intro {
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--sl-color-gray-2);
    max-width: 62ch;
  }

  .uc h2 {
    font-family: var(--uc-display);
    font-weight: 650;
    letter-spacing: -0.015em;
    font-size: 1.45rem;
    color: var(--sl-color-white);
    margin: 2.75rem 0 1.25rem;
  }

  /* ---------- Steps ---------- */
  .uc-steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.75rem 2rem;
  }
  .uc-step {
    position: relative;
    padding-top: 1rem;
    border-top: 1px solid var(--uc-border);
  }
  .uc-step-num {
    position: absolute;
    top: -0.72rem;
    left: 0;
    font-family: var(--uc-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: #cc0000;
    background: var(--sl-color-bg);
    padding-right: 0.8rem;
  }
  :root[data-theme='dark'] .uc-step-num,
  :root:not([data-theme='light']) .uc-step-num {
    color: #e04f4f;
  }
  .uc-step h3 {
    font-family: var(--uc-display);
    font-weight: 600;
    font-size: 1rem;
    color: var(--sl-color-white);
    margin: 0 0 0.4rem;
  }
  .uc-step p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  @media (max-width: 48rem) {
    .uc-steps {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- Feature blocks ---------- */
  .uc-features {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }
  .uc-feature {
    border: 1px solid var(--uc-border);
    border-radius: 0.85rem;
    padding: 1.15rem 1.3rem 1.1rem;
    background: color-mix(in srgb, var(--sl-color-black) 55%, var(--sl-color-bg));
  }
  .uc-feature h3 {
    font-family: var(--uc-display);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--sl-color-white);
    margin: 0 0 0.4rem;
  }
  .uc-feature h3::before {
    content: '✓';
    font-family: var(--uc-mono);
    color: var(--sl-color-green, #4ade80);
    margin-right: 0.5em;
  }
  .uc-feature p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
  }
  .uc-feature a {
    display: inline-block;
    margin-top: 0.6rem;
    font-family: var(--uc-mono);
    font-size: 0.74rem;
    color: var(--sl-color-accent-high);
    text-decoration: none;
  }
  .uc-feature a:hover {
    text-decoration: underline;
  }
  @media (max-width: 48rem) {
    .uc-features {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- FAQs ---------- */
  .uc-faq {
    border: 1px solid var(--uc-border);
    border-radius: 0.65rem;
    padding: 0.85rem 1.1rem;
    margin-top: 0.6rem;
  }
  .uc-faq summary {
    cursor: pointer;
    font-family: var(--uc-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--sl-color-white);
  }
  .uc-faq p {
    margin: 0.7rem 0 0.15rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  .uc-related {
    margin-top: 2rem;
    font-family: var(--uc-mono);
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }
  .uc-related a {
    color: var(--sl-color-accent-high);
    text-decoration: none;
  }
  .uc-related a:hover {
    text-decoration: underline;
  }

  /* ---------- CTA ---------- */
  .uc-cta {
    margin-top: 2.5rem;
    border: 1px solid var(--uc-border);
    border-radius: 1rem;
    padding: 1.6rem 1.75rem 1.75rem;
    background:
      radial-gradient(24rem 10rem at 20% -4rem, rgba(2, 132, 199, 0.14), transparent 70%),
      color-mix(in srgb, var(--sl-color-black) 55%, var(--sl-color-bg));
  }
  .uc-cta-title {
    font-family: var(--uc-display);
    font-weight: 650;
    font-size: 1.15rem;
    color: var(--sl-color-white);
    margin: 0 0 0.4rem;
  }
  .uc-cta > p:not(.uc-cta-title) {
    margin: 0;
    font-size: 0.92rem;
    color: var(--sl-color-gray-2);
    max-width: 56ch;
  }
  .uc-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.2rem;
  }
  .uc-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--uc-display);
    font-weight: 600;
    font-size: 0.88rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid var(--uc-border);
    color: var(--sl-color-white);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .uc-btn:hover {
    background: color-mix(in srgb, var(--sl-color-gray-6) 60%, transparent);
  }
  .uc-btn-primary {
    background: var(--sl-color-accent);
    border-color: transparent;
    color: #fff;
  }
  .uc-btn-primary:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 88%, #fff);
    transform: translateY(-1px);
  }
</style>
