---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

/**
 * Shared layout for /compare/* pages — honest, structured product comparisons.
 * Each page supplies data (intro, table rows, choose-lists, FAQs); this component
 * renders the layout, styling, and structured data (BreadcrumbList + FAQPage).
 *
 * Tone contract: comparisons must stay honest and respectful — every page carries
 * a "when to choose the other tool" section that genuinely argues for it. That's
 * both good manners and good SEO (it's the content people actually search for).
 */

export interface Cell {
  mark: 'yes' | 'no' | 'partial';
  text: string;
}

export interface Row {
  label: string;
  bp: Cell;
  other: Cell;
}

interface Props {
  /** Competitor display name, e.g. "Portainer". */
  competitor: string;
  /** Visible h1 / page title, e.g. "BridgePort vs Portainer". */
  title: string;
  /** Meta description (keyword-rich, ~155 chars). */
  description: string;
  /** Mono eyebrow line under the breadcrumb, e.g. "fleet control plane vs container platform GUI". */
  framing: string;
  /** Intro paragraphs (plain text). */
  intro: string[];
  /** Comparison table rows. */
  rows: Row[];
  /** Optional caveat under the table. */
  tableNote?: string;
  /** Bullet lists for the two "choose" cards. */
  chooseBp: string[];
  chooseOther: string[];
  /** FAQ entries (plain-text answers; also emitted as FAQPage JSON-LD). */
  faqs: { q: string; a: string }[];
}

const { competitor, title, description, framing, intro, rows, tableNote, chooseBp, chooseOther, faqs } =
  Astro.props;

const SITE = 'https://bridgeport.bridgein.com';
const pagePath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'BridgePort', item: `${SITE}/` },
        { '@type': 'ListItem', position: 2, name: 'Compare', item: `${SITE}/compare/` },
        { '@type': 'ListItem', position: 3, name: title, item: `${SITE}${pagePath}` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ],
});

const markGlyph = { yes: '✓', no: '—', partial: '◐' } as const;
---

<StarlightPage
  frontmatter={{
    title,
    description,
    template: 'splash',
    tableOfContents: false,
    editUrl: false,
    head: [{ tag: 'script', attrs: { type: 'application/ld+json' }, content: jsonLd }],
  }}
>
  <div class="cmp">
    <nav class="cmp-crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span aria-hidden="true">/</span><a href="/compare/">Compare</a>
    </nav>
    <p class="cmp-framing">{framing}</p>

    {intro.map((p) => <p class="cmp-intro">{p}</p>)}

    <h2 id="at-a-glance">At a glance</h2>
    <div class="cmp-table" role="table" aria-label={`Feature comparison: BridgePort vs ${competitor}`}>
      <div class="cmp-row cmp-head" role="row">
        <span role="columnheader" class="cmp-dim">Dimension</span>
        <span role="columnheader">BridgePort</span>
        <span role="columnheader">{competitor}</span>
      </div>
      {
        rows.map((row) => (
          <div class="cmp-row" role="row">
            <span role="rowheader" class="cmp-dim">{row.label}</span>
            <span role="cell" data-mark={row.bp.mark}>
              <i aria-hidden="true">{markGlyph[row.bp.mark]}</i>
              <span class="cmp-cell-label" aria-hidden="true">BridgePort</span>
              {row.bp.text}
            </span>
            <span role="cell" data-mark={row.other.mark}>
              <i aria-hidden="true">{markGlyph[row.other.mark]}</i>
              <span class="cmp-cell-label" aria-hidden="true">{competitor}</span>
              {row.other.text}
            </span>
          </div>
        ))
      }
    </div>
    {tableNote && <p class="cmp-note">{tableNote}</p>}

    <div class="cmp-choose">
      <div class="cmp-choice cmp-choice-bp">
        <h2 id="choose-bridgeport">Choose BridgePort if…</h2>
        <ul>
          {chooseBp.map((item) => <li>{item}</li>)}
        </ul>
      </div>
      <div class="cmp-choice">
        <h2 id={`choose-${competitor.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
          Choose {competitor} if…
        </h2>
        <ul>
          {chooseOther.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>

    <slot />

    <h2 id="faq">Frequently asked questions</h2>
    <div class="cmp-faqs">
      {
        faqs.map((f) => (
          <details class="cmp-faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>

    <aside class="cmp-cta">
      <p class="cmp-cta-title">See it for yourself</p>
      <p>
        BridgePort installs as a single container in about a minute — connect a server and judge it
        on your own infrastructure.
      </p>
      <div class="cmp-cta-actions">
        <a class="cmp-btn cmp-btn-primary" href="/getting-started/">Get started</a>
        <a class="cmp-btn" href="/compare/">All comparisons</a>
        <a class="cmp-btn" href="/faq/">FAQ</a>
      </div>
    </aside>
  </div>
</StarlightPage>

<style is:global>
  /* These styles only ship on pages that render this component. */

  /* Comparison pages are content pages, not articles — widen the splash column. */
  .cmp {
    --cmp-border: color-mix(in srgb, var(--sl-color-gray-5) 72%, transparent);
    --cmp-mono: 'IBM Plex Mono', ui-monospace, monospace;
    --cmp-display: 'IBM Plex Sans', var(--sl-font);
    max-width: 56rem;
    margin-inline: auto;
  }

  .cmp-crumbs {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-family: var(--cmp-mono);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.75rem;
  }
  .cmp-crumbs a {
    color: var(--sl-color-gray-3);
    text-decoration: none;
  }
  .cmp-crumbs a:hover {
    color: var(--sl-color-accent-high);
  }

  .cmp-framing {
    font-family: var(--cmp-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sl-color-accent-high);
    margin: 0 0 1.5rem;
  }
  .cmp-framing::before {
    content: '//';
    color: #cc0000;
    margin-right: 0.6em;
  }

  .cmp .cmp-intro {
    font-size: 1.02rem;
    line-height: 1.72;
    color: var(--sl-color-gray-2);
    max-width: 62ch;
  }

  .cmp h2 {
    font-family: var(--cmp-display);
    font-weight: 650;
    letter-spacing: -0.015em;
    font-size: 1.45rem;
    color: var(--sl-color-white);
    margin: 2.75rem 0 1.1rem;
  }

  /* ---------- Comparison table ---------- */
  .cmp-table {
    border: 1px solid var(--cmp-border);
    border-radius: 0.85rem;
    overflow: hidden;
  }
  .cmp-row {
    display: grid;
    grid-template-columns: 1.1fr 1.4fr 1.4fr;
    border-top: 1px solid var(--cmp-border);
  }
  .cmp-row:first-child {
    border-top: none;
  }
  .cmp-row > span {
    padding: 0.85rem 1rem;
    font-size: 0.88rem;
    line-height: 1.55;
    color: var(--sl-color-gray-2);
    border-inline-start: 1px solid var(--cmp-border);
  }
  .cmp-row > span:first-child {
    border-inline-start: none;
  }
  .cmp-head {
    background: color-mix(in srgb, var(--sl-color-gray-6) 70%, transparent);
  }
  .cmp-head > span {
    font-family: var(--cmp-display);
    font-weight: 600;
    font-size: 0.85rem;
    color: var(--sl-color-white);
  }
  .cmp-dim {
    font-family: var(--cmp-display);
    font-weight: 600;
    color: var(--sl-color-white) !important;
    font-size: 0.85rem !important;
  }
  .cmp-row [data-mark] > i {
    font-style: normal;
    font-family: var(--cmp-mono);
    margin-right: 0.55em;
  }
  .cmp-row [data-mark='yes'] > i { color: var(--sl-color-green, #4ade80); }
  .cmp-row [data-mark='partial'] > i { color: var(--sl-color-orange, #fdba74); }
  .cmp-row [data-mark='no'] > i { color: var(--sl-color-gray-4); }
  .cmp-cell-label {
    display: none;
  }
  @media (max-width: 48rem) {
    .cmp-row {
      grid-template-columns: 1fr;
    }
    .cmp-head > span:not(.cmp-dim) {
      display: none;
    }
    .cmp-row > span {
      border-inline-start: none;
      padding-block: 0.55rem;
    }
    .cmp-row > .cmp-dim {
      padding-bottom: 0;
    }
    .cmp-cell-label {
      display: inline-block;
      font-family: var(--cmp-mono);
      font-size: 0.66rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--sl-color-gray-4);
      width: 6.5em;
    }
  }

  .cmp-note {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.75rem;
  }

  /* ---------- Choose cards ---------- */
  .cmp-choose {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 1rem;
  }
  .cmp-choice {
    border: 1px dashed var(--cmp-border);
    border-radius: 0.85rem;
    padding: 0.4rem 1.35rem 1.2rem;
  }
  .cmp-choice-bp {
    border-style: solid;
    border-color: color-mix(in srgb, var(--sl-color-accent) 50%, var(--cmp-border));
  }
  .cmp-choice h2 {
    font-size: 1.05rem;
    margin: 1rem 0 0.75rem;
  }
  .cmp-choice ul {
    margin: 0;
    padding-left: 1.1rem;
  }
  .cmp-choice li {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    margin-top: 0.45rem;
  }
  @media (max-width: 48rem) {
    .cmp-choose {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- FAQs ---------- */
  .cmp-faq {
    border: 1px solid var(--cmp-border);
    border-radius: 0.65rem;
    padding: 0.85rem 1.1rem;
    margin-top: 0.6rem;
  }
  .cmp-faq summary {
    cursor: pointer;
    font-family: var(--cmp-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--sl-color-white);
  }
  .cmp-faq p {
    margin: 0.7rem 0 0.15rem;
    font-size: 0.9rem;
    line-height: 1.65;
    color: var(--sl-color-gray-2);
  }

  /* ---------- CTA ---------- */
  .cmp-cta {
    margin-top: 3rem;
    border: 1px solid var(--cmp-border);
    border-radius: 1rem;
    padding: 1.6rem 1.75rem 1.75rem;
    background:
      radial-gradient(24rem 10rem at 20% -4rem, rgba(2, 132, 199, 0.14), transparent 70%),
      color-mix(in srgb, var(--sl-color-black) 55%, var(--sl-color-bg));
  }
  .cmp-cta-title {
    font-family: var(--cmp-display);
    font-weight: 650;
    font-size: 1.15rem;
    color: var(--sl-color-white);
    margin: 0 0 0.4rem;
  }
  .cmp-cta > p:not(.cmp-cta-title) {
    margin: 0;
    font-size: 0.92rem;
    color: var(--sl-color-gray-2);
    max-width: 56ch;
  }
  .cmp-cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.2rem;
  }
  .cmp-btn {
    display: inline-flex;
    align-items: center;
    font-family: var(--cmp-display);
    font-weight: 600;
    font-size: 0.88rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    border: 1px solid var(--cmp-border);
    color: var(--sl-color-white);
    transition: background 0.15s ease, transform 0.15s ease;
  }
  .cmp-btn:hover {
    background: color-mix(in srgb, var(--sl-color-gray-6) 60%, transparent);
  }
  .cmp-btn-primary {
    background: var(--sl-color-accent);
    border-color: transparent;
    color: #fff;
  }
  .cmp-btn-primary:hover {
    background: color-mix(in srgb, var(--sl-color-accent) 88%, #fff);
    transform: translateY(-1px);
  }
</style>
